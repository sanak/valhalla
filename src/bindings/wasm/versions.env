# Pinned toolchain versions for the wasm bindings. Read by scripts/env.sh and by
# .github/workflows/wasm_bindings.yml (which also uses this file's hash as a cache key).
# protoc and the protobuf runtime must be the same release down to the patch number:
# protoc stamps `#if PROTOBUF_VERSION != <n>` into every generated .pb.h.
EMSDK_VERSION=6.0.9
PROTOBUF_VERSION=36.1
ZLIB_VERSION=1.3.1
